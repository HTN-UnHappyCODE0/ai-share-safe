# ==============================================================================
# AI Share Safe - Full Stack Environment Variables
# ==============================================================================

# 1. Database Configuration
DB_USER=aisharesafe
DB_PASSWORD=YourSecurePassword2026!
DB_NAME=aisharesafe_db

# 2. Google Gemini API Keys (Có thể nhập 1 hoặc nhiều keys phân tách bằng dấu phẩy)
GEMINI_API_KEYS=YOUR_GEMINI_API_KEY_1,YOUR_GEMINI_API_KEY_2

# 3. Bảo Mật & Mã Truy Cập
JWT_SECRET=super-secret-key-change-this-in-production-2026
DEFAULT_ACCESS_PASSCODE=gemini2026

# 4. Mô hình AI mặc định
DEFAULT_MODEL=gemini-3.7-flash

# 5. Frontend & Network
NEXT_PUBLIC_API_URL=http://localhost:8080
ALLOWED_ORIGINS=*
RATE_LIMIT_RPM=30
RATE_LIMIT_BURST=5

# 6. Cloudflare Tunnel Token (Nếu muốn public ra ngoài internet không cần mở port)
# CLOUDFLARE_TUNNEL_TOKEN=eyJhIjoi...
