# Server Configuration
PORT=8080
ENV=development

# Database Configuration
# Options: "sqlite" (default) or "postgres"
DATABASE_TYPE=postgres
DATABASE_URL=postgres://aisharesafe:YourSecurePassword@localhost:5432/aisharesafe_db?sslmode=disable

# Google Gemini API Keys (Có thể nhập 1 hoặc nhiều keys phân tách bằng dấu phẩy để tự động xoay vòng)
GEMINI_API_KEYS=YOUR_GEMINI_API_KEY_1,YOUR_GEMINI_API_KEY_2

# Bảo mật & Mã truy cập mặc định cho người dùng
JWT_SECRET=super-secret-key-change-this-in-production-2026
DEFAULT_ACCESS_PASSCODE=gemini2026

# CORS: Danh sách domain Frontend được phép gọi vào Backend
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate Limiting (Mặc định: 30 requests/phút, cho phép burst 5)
RATE_LIMIT_RPM=30
RATE_LIMIT_BURST=5

# Cấu hình AI
MAX_CONTEXT_MESSAGES=10
DEFAULT_MODEL=gemini-3.7-flash
